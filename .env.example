# Copy to .env (or ts/.env) for a LIVE SDK run against the companion server
# in app/. The SDK reads this file through the vendored sekreto dotenv
# provider — see .sdk/tm/ts/test/sdk-test-control.json.
#
# `.env` is gitignored; this example is not. These are the DEV credentials
# app/src/config.ts seeds by default, to a server holding public chemistry
# data, so there is nothing here to protect.

REFRESH_TOKEN=rt-elementdemo-dev-refresh-token
