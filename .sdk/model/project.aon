# Project overlay — YOURS. The scaffold creates this file once and never
# overwrites it, unlike every other file it writes.
#
# Everything else under model/ is toolchain-derived and is deliberately
# regenerated so that toolchain fixes propagate. Put anything here that is a
# decision about THIS project rather than a fact about the API.
#
# Included LAST by sdk.aon, after target/target-index.aon, because a key
# under main.kit.target.<t> can only refine a target that has already been
# defined. Declared earlier, the model build fails with "Cannot unify value:
# nil with value: string / key ext value was: nil", which names nothing that
# would lead you here.
#
# The release version each generated manifest declares (package.json,
# pyproject.toml, the gemspec, the rockspec) and that the port Makefiles tag:
#
#   main: kit: target: ts: publish: version: '1.2.3'
#
# Per target, because ports publish to different registries on different
# clocks. Set every target to the same value for a lockstep repo.
#
# A published package name that does not follow the derivation:
#
#   main: kit: target: ts: publish: registry: package: '@scope/name'


# This repo is voxgig-elementdemo-sdk, not the derived elementdemo-sdk. Sets
# the Go module path, and the homepage/repository/bugs URLs in every manifest.
# The slug stays 'elementdemo' so it can do its real job: naming the SDK
# (ElementdemoSDK), rather than being bent to make the derivation come true.
main: kit: repo: path: 'voxgig-sdk/voxgig-elementdemo-sdk'


# One release version across all targets: every artifact is generated from
# this one model, so a shared number is the honest claim.
main: kit: target: ts: publish: version: '0.1.0'
main: kit: target: go: publish: version: '0.1.0'
main: kit: target: py: publish: version: '0.1.0'
main: kit: target: java: publish: version: '0.1.0'


# Live tests ASSERT rather than skip. This project owns its test server
# (app/), so a live run that cannot reach it is a real failure and should
# say so, not skip to green.
main: kit: test: live: strict: true


# The bash target's release version, like the four above. Legal only once
# `package add ../ext` has put bash in the target index (this file refines,
# it cannot define).
main: kit: target: bash: publish: version: '0.1.0'


# ACCESS-TOKEN AUTH.
#
# The Elementdemo API takes a short-lived ACCESS token, bought with a
# long-lived REFRESH token at POST /api/<account-id>/auth/token — and it
# invalidates each access token after four requests, so a client that cannot
# re-buy one gets four calls in and then fails. The `secrets` feature's
# exchange is what does the buying; the refresh token itself is resolved
# through the vendored sekreto chain, from a `.env` file (or the process
# environment) rather than from code.
#
# This turns the feature ON for GENERATION: its source is emitted into the
# target and registered in the generated Config. Whether a given CLIENT uses
# it is a runtime option, like every other feature —
#
#   new ElementdemoSDK({
#     server: { account_id: 'acc01' },
#     feature: { secrets: {
#       active: true,
#       name: 'refresh_token',
#       providers: [{ kind: 'dotenv', file: '.env' }, { kind: 'env' }],
#       exchange: { active: true },
#     } },
#   })
#
# — and NOT something this file can preset. A feature's `config.options` in
# the toolchain model are concrete literals, so a project cannot refine them
# here (aontu: a concrete value conflicts with a concrete value, it does not
# yield), and they are the DECLARED defaults carried into the embedded
# config rather than values makeOptions merges. The live suite's copy of the
# block above lives in each target's `test/sdk-test-control.json`.
#
# Only `ts` carries this: the exchange is a thin layer over the vendored
# sekreto port, and `needs: { sekreto: true }` gates the feature to targets
# that have one. The other targets take an access token through the `apikey`
# option and must refresh it themselves.
main: kit: feature: secrets: active: true
