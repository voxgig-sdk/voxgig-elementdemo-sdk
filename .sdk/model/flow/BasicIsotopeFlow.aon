# BasicIsotopeFlow

main: kit: flow: BasicIsotopeFlow:
{
  entity: "isotope",
  kind: "basic",
  name: "BasicIsotopeFlow",
  step: [
    {
      input: {
        ref: "isotope_ref01"
      }

      match: {
        element_id: "element01"
      }

      op: "create"
    }

    {
      match: {
        element_id: "element01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "isotope_ref01"
          }
        }
      ]
    }

    {
      data: {
        element_id: "element01"
      }

      input: {
        ref: "isotope_ref01",
        srcdatavar: "isotope_ref01_data",
        suffix: "_up0",
        textfield: "halflife"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-isotope_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "isotope_ref01",
        srcdatavar: "isotope_ref01_data",
        suffix: "_dt0"
      }

      match: {
        element_id: "element01",
        id: "isotope01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-isotope_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "isotope_ref01",
        suffix: "_rm0"
      }

      match: {
        element_id: "element01",
        id: "isotope01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      match: {
        element_id: "element01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "isotope_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicIsotopeFlow"
}