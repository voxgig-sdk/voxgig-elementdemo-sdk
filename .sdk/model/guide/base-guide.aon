# Guide

guide: {
  metrics: count: entity: 4
  metrics: count: path: 10
  metrics: count: method: 16

  entity: element: {
    path: "/api/element": {
      op: create: method: *POST
      op: list: method: *GET
    }
    path: "/api/element/{element_id}": {
      rename: param: "element_id": *"id"
      op: load: method: *GET
      op: remove: method: *DELETE
      op: update: method: *PUT
    }
    path: "/api/element/{element_id}/ionize": {
      action: "ionize": {}
      rename: param: "element_id": *"id"
      op: create: method: *POST
    }
  }

  entity: group: {
    path: "/api/group": {
      op: list: method: *GET
    }
    path: "/api/group/{group_id}": {
      rename: param: "group_id": *"id"
      op: load: method: *GET
    }
  }

  entity: isotope: {
    path: "/api/element/{element_id}/isotope": {
      op: create: method: *POST
      op: list: method: *GET
    }
    path: "/api/element/{element_id}/isotope/{isotope_id}": {
      rename: param: "isotope_id": *"id"
      op: load: method: *GET
      op: remove: method: *DELETE
      op: update: method: *PUT
    }
    path: "/api/element/{element_id}/isotope/{isotope_id}/decay": {
      action: "decay": {}
      rename: param: "isotope_id": *"id"
      op: create: method: *POST
    }
  }

  entity: series: {
    path: "/api/series": {
      op: list: method: *GET
    }
    path: "/api/series/{series_id}": {
      rename: param: "series_id": *"id"
      op: load: method: *GET
    }
  }

}