{
  "name": "elementdemo-server",
  "version": "1.0.0",
  "description": "Periodic Table API server using Fastify",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "server": "npm run build && npm start",
    "validate": "tsx validate.ts",
    "validate:full": "bash scripts/validate-full.sh",
    "test": "npm run build && node --test \"dist/test/*.test.js\" \"dist/test/**/*.test.js\"",
    "test:watch": "node --test --watch \"dist/test/*.test.js\" \"dist/test/**/*.test.js\"",
    "test:unit": "npm run build && node --test dist/test/store/**/*.test.js",
    "test:integration": "npm run build && node --test dist/test/integration/**/*.test.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "fastify",
    "api",
    "typescript",
    "periodic-table"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "fastify": "^5.8.5",
    "nid": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
